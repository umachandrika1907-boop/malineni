# Environment variables for EduSuccess AI Backend
# Copy this file to .env and fill in real values

# Application
APP_NAME=EduSuccess AI
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./edusuccess.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:password@host:5432/edusuccess

# CORS — Frontend origin
FRONTEND_URL=http://localhost:5173

# Optional: Google Gemini API (Phase 2)
GEMINI_API_KEY=

# Upload limits
MAX_UPLOAD_SIZE_MB=5
